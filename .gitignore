# ==========================================================================
# mobile/ (Flutter app)
# ==========================================================================
mobile/.flutter-sdk/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#mobile/.vscode/

# Flutter/Dart/Pub related
mobile/**/doc/api/
mobile/ios/Flutter/.last_build_id
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
.pub-cache/
.pub/
mobile/build/

# Symbolication related
mobile/app.*.symbols

# Obfuscation related
mobile/app.*.map.json

# Android Studio will place build artifacts here
mobile/android/app/debug
mobile/android/app/profile
mobile/android/app/release

# Release signing — never commit the keystore or its passwords
mobile/android/key.properties
mobile/android/keystore/
mobile/**/*.jks
mobile/**/*.keystore

# Local build-time config — copy config.json.example and edit as needed
mobile/config.json

# iOS release signing
mobile/ios/certs/
mobile/ios/*.p12
mobile/ios/*.mobileprovision
mobile/ios/ExportOptions.plist

mobile/node_modules/

# ==========================================================================
# server/ (Node backend)
# ==========================================================================
server/node_modules/
server/.env
server/dist/

# ==========================================================================
# web/ (Next.js marketing site)
# ==========================================================================
web/node_modules/
web/.next/
web/out/
web/.env*.local

.env
