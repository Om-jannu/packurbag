# MongoDB connection string (required)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<database>

# Secret used to sign access tokens (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every issued access token immediately (refresh
# tokens are unaffected — they're random values stored/hashed in MongoDB, not
# signed with this secret).
JWT_SECRET=

# Port the server listens on (optional, defaults to 5000 — hosts like Render
# inject their own PORT at runtime, which takes precedence automatically)
PORT=5000

# development | production — controls how much detail error responses include
NODE_ENV=development

# Open Exchange Rates app ID, powers /currency/* (optional — currency routes
# return 503 if unset)
OPEN_EXCHANGE_RATES_APP_ID=

# OpenAI API key, powers /ai/chat (optional — AI chat returns 503 if unset)
OPENAI_API_KEY=

# OpenWeatherMap API key, powers /weather (optional — weather returns 503 if unset)
WEATHER_API_KEY=
