# MongoDB connection string (required)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<database>

# Port the server listens on (optional, defaults to 5000)
PORT=5000

# Comma-separated list of origins allowed to call this API in production
# (optional, defaults to "*" which allows any origin — fine for local dev)
ALLOWED_ORIGINS=

# Open Exchange Rates app ID, powers /currency/* (optional — currency routes
# return 503 if unset)
OPEN_EXCHANGE_RATES_APP_ID=

# OpenAI API key, powers /ai/chat (optional — AI chat returns 503 if unset)
OPENAI_API_KEY=

# OpenWeatherMap API key, powers /weather (optional — weather returns 503 if unset)
WEATHER_API_KEY=
